# sent_id = OGLC_00056
# text = ამათ თანა დედაქალაქსაცა შინა ხალკიდონელთასა მარკიანეს ზე მეფისა ჩუენისა ექუსას ოცდაათთა ღმრთივ სწავლულთა მამათა მართლმადიდებლობითსა ძეგლისწერასა დავამტკიცებთ, რომელთა ერთი ქრისტე ძე ღმრთისაჲ ორთა ბუნებათაგან შემოკრებული და მათვე ორთა ბუნებათა შინა დიდებული ჴმამაღლად უქადაგეს ყოველთა კიდეთა და ევტჳქი ცნობვანებული, რომელი დიდსა საიდუმლოსა განგებულებისასა საგონებელობით აღსრულებულად იტყოდა, ვითარცა გესლი რაჲმე და ჯერკუალი სამღდელოჲთგან ეზოთა ეკლესიისათა განსთხიეს.
