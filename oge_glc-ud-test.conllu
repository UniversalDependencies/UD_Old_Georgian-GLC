# sent_id = GLC_00315
# text = იოანე უღირსმან ეპისკოპოსმან ქალაქისა დჳსკოლაჲსამან სამთავროსა ბითჳნიელთასა განვასაზღვრენ და წარვწერენ; სისინი უღირსმან ეპისკოპოსმან ვასილინოპოლისამან ბითჳნიელთა სამთავროჲთ განვასაზღვრენ და წარვწერენ; გეორგი უღირსმან ეპისკოპოსმან კოდოსელთა ქალაქისამან სამთავროჲთ ბითჳნიელთაჲთ განვასაზღვრენ და წარვწერენ; იოანე უნდომან ეპისკოპოსმან ელენუპოლელთა ქალაქისამან ბითჳნიელთა სამთავროჲთ განვასაზღვრენ და წარვწერენ; იოანე უღირსმან ეპისკოპოსმან ნეოკესარიელთა ქალაქისამან ბითჳნიელთა სამთავროჲთ განვასაზღვრენ და წარვწერენ; სჳმეონ უღირსმან ეპისკოპოსმან თეოტოკიანუპოლისამან ბითჳნიელთა სამთავროჲთ განვასაზღვრენ და წარვწერენ; კოზმან უღირსმან ეპისკოპოსმან პრენეტიონელთა ქალაქისამან სამთავროსა ბითჳნიელთასა განვასაზღვრენ და წარვწერენ; თეოდორე უღირსმან ეპისკოპოსმან ახლისა იუსტინიანეს ქალაქისამან სამთავროჲთ ბითჳნიელთაჲთ განვასაზღვრენ და წარვწერენ; ისიდორე უღირსმან ეპისკოპოსმან ღორდოსევრონისამან ბითჳნიელთა სამთავროჲსამან განვასაზღვრენ და და წარვწერენ; ანასტასი უღირსმან ეპისკოპოსმან ლინოჲსამან სამთავროსა შინა ბითჳნიელთასა განვასაზღვრენ და წარვწერენ; ტატის უნდომან ეპისკოპოსმან ქალაქისა კოლივრასოჲსამან სამთავროჲთ პამფჳლიისაჲთ განვასაზღვრენ და წარვწერენ; თეოდორე უნდომან ეპისკოპოსმან ქალაქისა ერჳმნონისამან სამთავროჲთ პამფჳლიისაჲთ განვასაზღვრენ და წარვწერენ; კონონ წყალობითა ღმრთისაჲთა ეპისკოპოსმან კორაკისოჲსამან სამთავროსა შინა პამფჳლიელთასა განვასაზღვრენ და წარვწერენ; გეორგი უნდომან ეპისკოპოსმან ქალაქისა სჳდრეონისამან სამთავროჲთ პამფჳლიისაჲთ განვასაზღვრენ და წარვწერენ; კალინიკოს მადლითა ქრისტესითა ეპისკოპოსმან კოლონეატელთა ქალაქისამან დიდით სომხეთით განვასაზღვრენ და წარვწერენ; ფოტი მადლითა ქრისტესითა ეპისკოპოსმან ნიკოპოლისამან დიდით სომხეთით განვასაზღვრენ და წარვწერენ; გრიგოლი მადლითა ქრისტესითა ეპისკოპოსმან იუტალეონელთა ქალაქისამან დიდისა სომეხთა სამთავროჲსამან განვასაზღვრენ და წარვწერენ; ფოტი უღირსმან ეპისკოპოსმან ქალაქისა სევასტოპოლელთაჲსამან განვასაზღვრენ და წარვწერენ; თეოდორე უღირსმან ეპისკოპოსმან ქალაქისა ამასეოჲსამან სამთავროჲთ ელისპონტოჲსაჲთ განვასაზღვრენ და წარვწერენ; სერგი უნდომან ეპისკოპოსმან ანდრიაპოლელთამან განვასაზღვრენ და წარვწერენ; ფოტი უღირსმან ეპისკოპოსმან ქალაქისა ივოროჲსამან სამთავროჲთ ელისპონტოჲსაჲთ განვასაზღვრენ და წარვწერენ; გეორგი უნდომან ეპისკოპოსმან ქალაქისა ზილონისამან განვასაზღვრენ და წარვწერენ; იოანე უღირსმან ეპისკოპოსმან კურუკუელთა ქალაქისამან სამთავროჲთ კილიკიისაჲთ განვასაზღვრენ და წარვწერენ; პეტრე უღირსმან ეპისკოპოსმან ქალაქისა ზეფირისამან პირველით სამთავროჲთ კილიკიისაჲთ განვასაზღვრენ და წარვწერენ; ბასილი ცოდვილმან ეპისკოპოსმან ქალაქისა ეპიფანიაჲსამან მეორით სამთავროჲთ კილიკიისაჲთ განვასაზღვრენ და წარვწერენ; პავლე უღირსმან ეპისკოპოსმან ირინოპოლისამან მეორით სამთავროჲთ კილიკიელთაჲთ განვასაზღვრენ და წარვწერენ; თეოდორე უნდომან ეპისკოპოსმან ქალაქისა კასტავლონისამან განვასაზღვრენ და წარვწერენ; სისინი უღირსმან ეპისკოპოსმან კიტიდიოპოლისამან განვასაზღვრენ და წარვწერენ.
# translit = ioane uġirsman episkoposman kʻalakʻisa dwskolaysaman samtʻavrosa bitʻwnieltʻasa ganvasazġvren da carvceren; sisini uġirsman episkoposman vasilinopolisaman bitʻwnieltʻa samtʻavroytʻ ganvasazġvren da carvceren; georgi uġirsman episkoposman kodoseltʻa kʻalakʻisaman samtʻavroytʻ bitʻwnieltʻaytʻ ganvasazġvren da carvceren; ioane undoman episkoposman elenupoleltʻa kʻalakʻisaman bitʻwnieltʻa samtʻavroytʻ ganvasazġvren da carvceren; ioane uġirsman episkoposman neokesarieltʻa kʻalakʻisaman bitʻwnieltʻa samtʻavroytʻ ganvasazġvren da carvceren; swmeon uġirsman episkoposman tʻeotokianupolisaman bitʻwnieltʻa samtʻavroytʻ ganvasazġvren da carvceren; kozman uġirsman episkoposman prenetioneltʻa kʻalakʻisaman samtʻavrosa bitʻwnieltʻasa ganvasazġvren da carvceren; tʻeodore uġirsman episkoposman axlisa iustinianes kʻalakʻisaman samtʻavroytʻ bitʻwnieltʻaytʻ ganvasazġvren da carvceren; isidore uġirsman episkoposman ġordosevronisaman bitʻwnieltʻa samtʻavroysaman ganvasazġvren da da carvceren; anastasi uġirsman episkoposman linoysaman samtʻavrosa šina bitʻwnieltʻasa ganvasazġvren da carvceren; tatis undoman episkoposman kʻalakʻisa kolivrasoysaman samtʻavroytʻ pampʻwliisaytʻ ganvasazġvren da carvceren; tʻeodore undoman episkoposman kʻalakʻisa erwmnonisaman samtʻavroytʻ pampʻwliisaytʻ ganvasazġvren da carvceren; konon cqalobitʻa ġmrtʻisaytʻa episkoposman korakisoysaman samtʻavrosa šina pampʻwlieltʻasa ganvasazġvren da carvceren; georgi undoman episkoposman kʻalakʻisa swdreonisaman samtʻavroytʻ pampʻwliisaytʻ ganvasazġvren da carvceren; kalinikos madlitʻa kʻristesitʻa episkoposman koloneateltʻa kʻalakʻisaman diditʻ somxetʻitʻ ganvasazġvren da carvceren; pʻoti madlitʻa kʻristesitʻa episkoposman nikopolisaman diditʻ somxetʻitʻ ganvasazġvren da carvceren; grigoli madlitʻa kʻristesitʻa episkoposman iutaleoneltʻa kʻalakʻisaman didisa somextʻa samtʻavroysaman ganvasazġvren da carvceren; pʻoti uġirsman episkoposman kʻalakʻisa sevastopoleltʻaysaman ganvasazġvren da carvceren; tʻeodore uġirsman episkoposman kʻalakʻisa amaseoysaman samtʻavroytʻ elispontoysaytʻ ganvasazġvren da carvceren; sergi undoman episkoposman andriapoleltʻaman ganvasazġvren da carvceren; pʻoti uġirsman episkoposman kʻalakʻisa ivoroysaman samtʻavroytʻ elispontoysaytʻ ganvasazġvren da carvceren; georgi undoman episkoposman kʻalakʻisa zilonisaman ganvasazġvren da carvceren; ioane uġirsman episkoposman kurukueltʻa kʻalakʻisaman samtʻavroytʻ kilikiisaytʻ ganvasazġvren da carvceren; petre uġirsman episkoposman kʻalakʻisa zepʻirisaman pirvelitʻ samtʻavroytʻ kilikiisaytʻ ganvasazġvren da carvceren; basili cʻodvilman episkoposman kʻalakʻisa epipʻaniaysaman meoritʻ samtʻavroytʻ kilikiisaytʻ ganvasazġvren da carvceren; pavle uġirsman episkoposman irinopolisaman meoritʻ samtʻavroytʻ kilikieltʻaytʻ ganvasazġvren da carvceren; tʻeodore undoman episkoposman kʻalakʻisa kastavlonisaman ganvasazġvren da carvceren; sisini uġirsman episkoposman kitidiopolisaman ganvasazġvren da carvceren.
